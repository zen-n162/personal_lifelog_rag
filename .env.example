# Keep this application local-first. Do not put cloud API keys here unless a
# future feature explicitly documents why they are needed.

PERSONAL_LIFELOG_RAG_DB_PATH=data/db/lifelog.sqlite
PERSONAL_LIFELOG_RAG_CONFIG=configs/app.example.yaml
PERSONAL_LIFELOG_RAG_DEFAULT_YEAR=2024

# Optional local-only OCR/VLM settings. Leave unset to skip as "未解析".
# PERSONAL_LIFELOG_RAG_OCR_BACKEND=tesseract
# PERSONAL_LIFELOG_RAG_OCR_LANG=jpn+eng
# PERSONAL_LIFELOG_RAG_VLM_BACKEND=ollama
# PERSONAL_LIFELOG_RAG_VLM_MODEL=llava
# PERSONAL_LIFELOG_RAG_OLLAMA_URL=http://127.0.0.1:11434
# PERSONAL_LIFELOG_RAG_LLAMA_CPP_URL=http://127.0.0.1:8080

# Optional rule-based event builder tuning.
# PERSONAL_LIFELOG_RAG_EVENT_PHOTO_GAP_MINUTES=90
# PERSONAL_LIFELOG_RAG_EVENT_LINE_GAP_MINUTES=120
# PERSONAL_LIFELOG_RAG_EVENT_MERGE_WINDOW_MINUTES=90
# PERSONAL_LIFELOG_RAG_EVENT_GPS_DISTANCE_METERS=500
